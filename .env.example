# ENICE Group — environment template.
# Copy to `.env` and fill in real values. `.env` is git-ignored; never commit secrets.
#
# Every variable here is server-side only and is read by the Vercel functions in `api/`.
# There are no VITE_-prefixed variables: nothing secret or environment-specific is needed
# by the browser bundle, and the client only ever calls same-origin `/api/*` routes.

# ===========================================================================
# WEBSITE MANAGER — the private admin CMS at /admin.
#
# Four variables, and that is the whole list. The manager publishes content and
# holds the assistant's knowledge notes; it deliberately has no media library, no
# AI proposal queue and no PDF ingestion, because each of those needed storage or
# provider credentials to be useful and would otherwise ship as a button that is
# disabled in every environment the site actually runs in.
# ===========================================================================

# ---------------------------------------------------------------------------
# Database (REQUIRED for the Website Manager).
# Any Postgres works — Vercel Postgres, Neon, Supabase, RDS, self-hosted.
# Point this at a POOLED endpoint (PgBouncer / transaction mode) for serverless;
# the driver runs with prepared statements disabled so a pooler is safe.
# Migrations run automatically on the first request after a deploy.
# ---------------------------------------------------------------------------
DATABASE_URL=
# POSTGRES_URL is also read (what Vercel Postgres injects). DATABASE_URL wins if both are set.
#
# Attaching a database store in Vercel under a *prefix* renames every variable the provider
# publishes: connecting Neon under the prefix "DATABASE" yields DATABASE_DATABASE_URL rather
# than DATABASE_URL. Those variables are owned by the integration and cannot be renamed, so a
# prefixed name is accepted too — any variable ending in _DATABASE_URL, _POSTGRES_URL,
# _POSTGRES_PRISMA_URL, _DATABASE_URL_UNPOOLED or _POSTGRES_URL_NON_POOLING whose value starts
# with postgres:// or postgresql://. Bare names and pooled endpoints are preferred; a variable
# set here always wins over one an integration injected.

# ---------------------------------------------------------------------------
# Application secret (REQUIRED for the Website Manager).
# At least 32 characters of randomness. Generate with:  openssl rand -base64 48
# Encrypts stored two-factor secrets and signs CSRF tokens. Rotating it invalidates
# TOTP secrets (administrators fall back to recovery codes) and in-flight CSRF tokens.
# ---------------------------------------------------------------------------
CMS_SECRET=

# ---------------------------------------------------------------------------
# First-owner bootstrap. Used ONLY when the administrators table is empty — the
# first sign-in creates this Owner account, then these are ignored. There is no
# public registration and no unauthenticated setup route, so this is the only way
# to create the initial account. Change the password after signing in.
# ---------------------------------------------------------------------------
CMS_OWNER_EMAIL=
CMS_OWNER_PASSWORD=
CMS_OWNER_NAME=ENICE Owner


# ===========================================================================
# EXISTING SITE FEATURES
# ===========================================================================

# ---------------------------------------------------------------------------
# Email provider — transactional email and stored form data.
#
# The site talks to one provider-agnostic interface (src/lib/email), so switching
# provider is this variable plus that provider's credentials. Nothing else changes.
#
#   pulseassist  (default) PulseAssist Email — ENICE's own product.
#   resend       The previous provider, kept so the switch is reversible.
# ---------------------------------------------------------------------------
EMAIL_PROVIDER=pulseassist

# The domain all site email is sent from. MUST be a domain verified with the active
# provider, or mail will be refused. PulseAssist appends this to the sender's local
# part (it never accepts a full From address), so a mismatch is rejected up front
# rather than silently rewritten.
EMAIL_FROM_DOMAIN=enicehq.com

# ---------------------------------------------------------------------------
# PulseAssist Email (required when EMAIL_PROVIDER=pulseassist)
#
# Create the key in the PulseAssist Email console -> API keys. It needs the `send`
# scope, and the account needs an Email plan that includes API access — the free
# plan does not, and the API answers 403 EMAIL_CAPABILITY_REQUIRED without it.
#
# Before any mail will send, EMAIL_FROM_DOMAIN must be added under Domains in that
# console and its DKIM/SPF records published at the registrar.
# ---------------------------------------------------------------------------
PULSEASSIST_API_KEY=

# Optional. Defaults to https://getpulseassist.com — the API lives on the APEX
# domain; there is no api. subdomain and api.getpulseassist.com does not resolve.
# Set this only to point at a staging deployment of the API.
# PULSEASSIST_API_URL=

# Optional. Pin existing PulseAssist lists by id (integers). If unset, the lists are
# looked up by name and created on first use, so neither needs setting.
# PULSEASSIST_EARLY_ACCESS_LIST_ID=
# PULSEASSIST_UPDATES_LIST_ID=

# ---------------------------------------------------------------------------
# Resend (required only when EMAIL_PROVIDER=resend)
# ---------------------------------------------------------------------------
RESEND_API_KEY=

# Optional. Segment holding PulseAssist early-access registrations. If unset, the
# "PulseAssist Early Access" segment is looked up by name and created on first use,
# so this only needs setting to pin a specific existing segment.
# RESEND_EARLY_ACCESS_SEGMENT_ID=


# ---------------------------------------------------------------------------
# PulseAssist chat widget (OPTIONAL) — the assistant on the public site.
#
# The site embeds a PulseAssist chatbot by id. Defaults to 36 (ENICE's, in the
# `enice-technology-limited` workspace); set this only to point at a different chatbot, e.g. a
# staging one, or after recreating the live one.
#
# This is the one VITE_-prefixed variable in the project, and it is safe: a widget id is public by
# definition — it appears in the script URL every visitor loads. Nothing secret is added to the
# bundle by it.
#
# Two things have to be true for the chat to actually answer:
#   1. The id resolves. If it does not, `GET /api/widget/<id>/widget.js` answers 404 and the site
#      falls back to its own launcher pointing at the contact form rather than showing nothing.
#      (The previous id, 33, answers 404 — "chatbot not found or inactive".)
#   2. The domain being served is in that widget deployment's allowlist, or the chat endpoint
#      answers 403 and the launcher opens but cannot send. Vercel preview domains are not
#      `enicehq.com`, so add them there to test a preview.
#
# The loader's origin is already allowed in vercel.json's script-src.
# VITE_PULSEASSIST_WIDGET_ID=36

