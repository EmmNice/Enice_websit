# ENICE Group — environment template.
# Copy to `.env` and fill in real values. `.env` is git-ignored; never commit secrets.
#
# Anything prefixed with VITE_ is inlined into the client bundle at build time and is
# therefore PUBLIC. Never put a secret behind a VITE_ prefix.

# ---------------------------------------------------------------------------
# Supabase — public (browser) credentials
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Server-side mirrors of the above, read by Node/Vercel handlers.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx
SUPABASE_PROJECT_ID=your-project-ref

# ---------------------------------------------------------------------------
# Supabase — SECRET. Bypasses Row Level Security. Server only.
# Required by the Edge Functions (Supabase injects it automatically there).
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Resend — transactional email. Server only.
# RESEND_AUDIENCE_ID enables watchlist duplicate detection; without it every
# submission re-sends the confirmation email.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# ---------------------------------------------------------------------------
# Shared password gating /admin/watchlist and /admin/early-access.
# Must be set in BOTH Vercel (for /api/admin/*) and Supabase Edge Function
# secrets (for admin-early-access), otherwise those routes return 500.
# ---------------------------------------------------------------------------
ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# AI chatbot (/api/chat). Provider defaults to `bedrock`.
# One of: bedrock | openai | anthropic | gemini | deepseek | grok | openrouter | custom
# Missing credentials degrade gracefully to a static fallback reply.
# ---------------------------------------------------------------------------
AI_PROVIDER=bedrock
AI_API_KEY=
AI_API_SECRET=
AI_REGION=us-east-1
# Optional overrides:
# AI_MODEL=
# AI_BASE_URL=

# ---------------------------------------------------------------------------
# CI only — Sanity Studio deploys (GitHub Actions secret SANITY_AUTH_TOKEN).
# ---------------------------------------------------------------------------
# SANITY_AUTH_TOKEN=
