modules = ["nodejs-20", "web"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "bun run dev"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

# `vite build` emits a static SPA to `dist/` — there is no Nitro/TanStack Start server
# entry, so the previous `run = [".output/server/index.mjs"]` could never start.
# Production hosting is Vercel (see vercel.json); this target is preview only and the
# /api/* functions are not served here.
[deployment]
deploymentTarget = "static"
publicDir = "dist"
build = ["bun", "run", "build"]

[userenv]

# Non-secret defaults only. Secrets (RESEND_API_KEY, ADMIN_PASSWORD, AI_API_KEY,
# AI_API_SECRET, SUPABASE_SERVICE_ROLE_KEY) belong in Replit Secrets, never in this file.
[userenv.shared]
AI_PROVIDER = "bedrock"
